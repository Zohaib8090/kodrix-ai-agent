<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12 (API 31) and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- API keys and the GitHub token (PreferenceStorage.PREFS_FILE_NAME) are never uploaded. -->
        <exclude domain="sharedpref" path="nocode_prefs.xml" />
        <!-- The embedded Linux environment is large and can be downloaded again. -->
        <exclude domain="file" path="usr" />
        <exclude domain="file" path="home" />
        <exclude domain="file" path="nodejs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="usr" />
        <exclude domain="file" path="home" />
        <exclude domain="file" path="nodejs" />
    </device-transfer>
</data-extraction-rules>
