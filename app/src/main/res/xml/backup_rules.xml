<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 (API 30) and lower.
   See https://developer.android.com/guide/topics/data/autobackup
   Android 12+ uses data_extraction_rules.xml instead.
-->
<full-backup-content>
    <!-- API keys and the GitHub token (PreferenceStorage.PREFS_FILE_NAME) stay on this device. -->
    <exclude domain="sharedpref" path="nocode_prefs.xml" />
    <!-- The embedded Linux environment is large and can be downloaded again. -->
    <exclude domain="file" path="usr" />
    <exclude domain="file" path="home" />
    <exclude domain="file" path="nodejs" />
</full-backup-content>
